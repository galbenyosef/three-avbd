+/** Per-pair interlock resolution: an exact witness fixes the pair's contact direction. Optimizer
+ * points that push the opposite way are dropped only where their own normal is ambiguous: inside
+ * both fields with aligned gradients (phiA+phiB has no resolving direction). Outside-both points
+ * have gap-derived normals and can represent a different flank; keep those independent contacts. */
+fn dropOpposedAmbiguous(normal: vec3f, count: u32) {
+  for(var i=0u;i<count;i++) {
+    let q=work.points[i];
+    if(q.flags.x==0u || dot(q.normal.xyz,normal)>=0.0) { continue; }
+    let a=worldField(bodyA,q.x.xyz); let b=worldField(bodyB,q.x.xyz); work.stats.x+=1u;
+    if(a.phi<0.0 && b.phi<0.0 && dot(a.gradient,b.gradient)>0.0) { work.points[i].flags.x=0u; }
+  }
+}
